# 服务端环境变量模板（复制为 .env 后填入真实值，.env 已被 .gitignore 忽略）

# 必填：API 访问密钥。未设置时服务器将拒绝启动（fail-fast）。
# 前端需通过 VITE_API_KEY 配置相同的值，并在请求头 X-API-Key 携带。
API_KEY=

# 运行环境：production（默认，禁止泄露错误堆栈）或 development（本地调试）
NODE_ENV=production

# 监听端口
PORT=3006

# CORS 允许的源，逗号分隔。例如：http://localhost:5173,https://study.example.com
# 留空表示不发送 CORS 头（同源部署时足够）；配置后才会携带凭据。
CORS_ORIGIN=
