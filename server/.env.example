# ============================================================
# 环境变量模板
#
# 用法：复制为「仓库根目录」的 .env 后填入真实值
#     cp server/.env.example .env
#
# 全局唯一：后端（dotenv）与前端构建（Vite envDir 指向仓库根）均读取该文件。
# .env 已被 .gitignore 忽略，请勿提交真实密钥。
# ============================================================


# ---------------- 后端：必填 ----------------

# 接口访问密钥，用于校验前后端接口调用（X-API-Key 请求头）。
# 未设置时服务器拒绝启动（fail-fast）。
# 前端需通过 VITE_API_KEY 配置相同的值，否则所有接口返回 401。
API_KEY=

# DeepSeek API 密钥，用于 AI 评分、AI 起名、AI 出题、周报分析、
# 学习心得评估与智能测验。未设置时上述 AI 能力调用失败。
DEEPSEEK_API_KEY=


# ---------------- 后端：可选 ----------------

# DeepSeek 接口地址，缺省 https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 运行环境：production（默认，禁止向客户端返回错误堆栈）或 development（本地调试）
NODE_ENV=production

# 监听端口，缺省 3006
PORT=3006

# 数据库路径，相对 APP_ROOT 解析（开发态为仓库根，部署态为部署目录）。
# 缺省 data/study.db；建议生产环境使用绝对路径指向部署目录之外，避免随打包被清除。
DB_PATH=data/study.db

# CORS 允许的源，逗号分隔。例如：http://localhost:5173,https://study.example.com
# 留空表示不发送 CORS 头（同源部署时足够）；配置后才会携带凭据。
CORS_ORIGIN=

# HSTS（Strict-Transport-Security）开关，缺省 false。
# 仅当确有真实 TLS 终端（如前置代理终止 HTTPS）时才设为 true。纯局域网 HTTP 部署
# 必须保持 false，否则浏览器会记住该主机强制走 HTTPS，导致 http://IP:端口 直连
# 被升级为 https 而报 ERR_SSL_PROTOCOL_ERROR。
ENABLE_HSTS=false

# 前端产物目录，相对 APP_ROOT 解析，缺省 dist。
DIST_PATH=dist

# 应用根目录覆盖，缺省时开发态取仓库根、部署态取进程工作目录。
# APP_ROOT=


# ---------------- 数据库每日备份（可选）----------------
# 每日定时把 SQLite 库打包为 zip 并以邮件外发，用作异地容灾。
# 功能默认全关，不填即不影响主服务；必填项缺失时自动禁用并打印中文告警。

# 总开关，缺省 false。置为 true 才启用备份与邮件发送。
BACKUP_ENABLED=false

# 每日触发时刻，24 小时制 HH:mm（本地时区），缺省 03:00。
# 启动晚于该时刻时会在开机 30 秒后补发一次，适配非全天开机的机器。
BACKUP_TIME=03:00

# zip 超过该体积（MB）时跳过发送并告警，避免 SMTP 拒收后反复重试，缺省 20。
BACKUP_MAX_ATTACHMENT_MB=20

# 发送端 SMTP。QQ 邮箱填 smtp.qq.com / 465 / true；
# SMTP_PASS 填邮箱「授权码」而非 QQ 密码，需在邮箱网页端
# 「设置 → 账户 → POP3/IMAP/SMTP 服务」中开启服务后生成。
SMTP_HOST=
SMTP_PORT=465
# 465 端口配 true（SSL 直连）；587 端口配 false（STARTTLS 协商）。
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# 发件人，缺省取 SMTP_USER。
MAIL_FROM=
# 收件人，多个用逗号分隔。自发自收时填与 SMTP_USER 相同的地址。
MAIL_TO=

# 邮箱侧保留策略：收件箱与「已发送」各保留最新若干封，旧备份移入「已删除」文件夹。
# 自发自收会在收件箱与「已发送」各留一份副本，故两个文件夹都需清理。
# 填写 IMAP_HOST 后生效；IMAP_USER / IMAP_PASS 留空时复用 SMTP 的账号与密码。
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
# 备份邮件所在的收件箱，缺省 INBOX。
IMAP_MAILBOX=INBOX
# 每个文件夹保留的最新份数，0 表示不清理（邮件只增不减）。
# 建议先用 0 跑一周确认备份正常，再改为 20 启用清理。
BACKUP_RETENTION=0
# 单次最多移动的封数（安全阀，防止过滤异常时批量误删），缺省 5。
BACKUP_RETENTION_MAX_DELETE=5
# 「已发送」与「已删除」的文件夹名。留空时按 IMAP 的 special-use 标志自动探测；
# 探测失败会打印全部文件夹清单，届时按清单填写（QQ 邮箱通常为「已发送」「已删除」）。
# IMAP_SENT_FOLDER=
# IMAP_TRASH_FOLDER=


# ---------------- 前端：构建期注入 ----------------
# Vite 仅将 VITE_ 前缀的变量注入客户端，且为「构建期」编译进 dist 的 JS，
# 修改后必须重新执行 pnpm build 才会生效。

# 后端接口密钥，必须与 API_KEY 相同，随每个请求以 X-API-Key 头发送。
VITE_API_KEY=

# 管理员判定的主机名或 IP，用于放开「设置 / 规则配置」等管理页面。
# 留空则仅 localhost 与 127.0.0.1 被视为管理员。
VITE_ADMIN_DOMAINS=


# ---------------- 仅测试使用 ----------------

# 测试时覆盖为隔离的库（如 :memory:），避免污染真实数据库。正常运行无需设置。
# TEST_DB_URL=


# ---------------- 已迁至数据库配置 ----------------
# 以下配置不再通过环境变量设置，改由「设置」页面维护并存入 options 表：
#   - 视频分发目录（原 DISTRIBUTION_PATH），读取 systemConfig.videoDirectory
#   - 自动保存间隔（原 AUTOSAVE_INTERVAL），由 /api/system 返回
#   - 积分规则、兑换比例、评语与名言等
